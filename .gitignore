# Dependency directories
node_modules/
backend/node_modules/
frontend/node_modules/

# Production build outputs
dist/
build/
frontend/dist/
.next/
out/

# Environment files and credentials (CRITICAL: NEVER COMMIT SECRETS)
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
backend/.env
frontend/.env
!.env.example
!backend/.env.example
!frontend/.env.example

# Logs and runtime data
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.system_generated/

# Uploaded and temporary user records (Local media & documents)
uploads/
backend/uploads/
scratch/

# Python caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage

# Operating System and Editor files
.DS_Store
Thumbs.db
ehthumbs.db
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Cloud and sync conflict files
*-LAPTOP-*.json
*-LAPTOP-*.js
*-LAPTOP-*.jsx
*-LAPTOP-*.html
