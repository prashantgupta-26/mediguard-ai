# ========================================================
# MediGuard AI — Production & Local Environment Variables
# (Copy to .env or configure in Render / Vercel dashboard)
# ========================================================

# --- BACKEND CONFIGURATION (Render Web Service) ---
PORT=5000
NODE_ENV=production

# MongoDB Database Connection
MONGODB_URI=

# Authentication Security
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Google Gemini AI Integration (Required for OCR, Summaries, Interactions)
GEMINI_API_KEY=

# CORS Allowed Frontend Origin (Your Vercel deployment URL)
# Example: https://mediguard-ai.vercel.app
FRONTEND_URL=

# Gmail SMTP Email Verification Service
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# Optional ABDM / HIS Interoperability Sandbox Settings
INTEGRATION_MODE=local
ABDM_BASE_URL=
ABDM_CLIENT_ID=
ABDM_CLIENT_SECRET=
HIS_BASE_URL=
FHIR_SERVER_URL=

# --- FRONTEND CONFIGURATION (Vercel Project Settings) ---
# Backend URL where the Render API is running
# Example: https://mediguard-ai-backend.onrender.com
VITE_API_URL=
